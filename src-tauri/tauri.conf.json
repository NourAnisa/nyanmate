{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyanMate",
  "version": "0.2.0",
  "identifier": "com.nouranisa.nyanmate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NyanMate",
        "label": "main",
        "width": 430,
        "height": 540,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
