{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NyanMate",
  "version": "0.29.0",
  "identifier": "com.nouranisa.nyanmate",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [
    { "title":"NyanMate","label":"main","width":430,"height":540,"transparent":true,"decorations":false,"alwaysOnTop":true,"resizable":false,"shadow":false,"skipTaskbar":true },
    { "title":"NyanMate Presenter","label":"presenter","width":460,"height":760,"visible":false,"decorations":true,"alwaysOnTop":false,"resizable":true,"skipTaskbar":false },
    { "title":"NyanMate Class Reports","label":"reports","width":1040,"height":760,"visible":false,"decorations":true,"alwaysOnTop":false,"resizable":true,"skipTaskbar":false },
    { "title":"NyanMate Smart Agenda","label":"agenda","width":880,"height":760,"visible":false,"decorations":true,"alwaysOnTop":false,"resizable":true,"skipTaskbar":false },
    { "title":"NyanMate File Assistant","label":"assistant","width":900,"height":760,"visible":false,"decorations":true,"alwaysOnTop":false,"resizable":true,"skipTaskbar":false }
  ], "security": { "csp": null } },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Indonesian"]
      }
    }
  }
}
